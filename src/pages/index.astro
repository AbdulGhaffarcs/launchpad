---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const categories = [...new Set(projects.map((p) => p.data.category))].sort();
---
<BaseLayout title="Launchpad" description="Discover projects built by the IBA CS community.">
  <section class="hero">
    <p class="eyebrow">IBA CS BUILDER COMMUNITY</p>
    <h1>See what people are building.</h1>
    <p class="hero-copy">A permanent showcase of projects built by students in the IBA CS community.</p>
    <div class="hero-actions">
      <a class="button primary" href="/submit">Showcase a project</a>
      <a class="button secondary" href="#latest">Explore projects</a>
    </div>
    <div class="stats">
      <div><strong>{projects.length}</strong><span>projects</span></div>
      <div><strong>{new Set(projects.map((p) => p.data.studentName)).size}</strong><span>builders</span></div>
      <div><strong>320+</strong><span>CS students</span></div>
    </div>
  </section>

  {featured && (
    <section class="featured-wrap">
      <div class="section-heading"><span>Featured</span><a href={`/projects/${featured.id}`}>Open project →</a></div>
      <article class="featured-card">
        <div>
          <p class="eyebrow">CURRENT FEATURE</p>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <p class="muted">Built by {featured.data.studentName}</p>
          <a class="button primary" href={`/projects/${featured.id}`}>View project</a>
        </div>
        <div class="featured-meta">
          <span>{featured.data.category}</span>
          <div class="stack large">{featured.data.stack.map((item) => <span>{item}</span>)}</div>
        </div>
      </article>
    </section>
  )}

  <section id="latest" class="projects-section">
    <div class="section-heading"><span>Latest projects</span><span class="muted">{projects.length} total</span></div>
    <div class="filters">
      <input id="project-search" placeholder="Search projects or builders…" autocomplete="off" />
      <select id="category-filter">
        <option value="">All categories</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </div>
    <div class="project-grid" id="project-grid">
      {projects.map((project) => <div class="project-item" data-title={project.data.title.toLowerCase()} data-student={project.data.studentName.toLowerCase()} data-category={project.data.category}><ProjectCard project={project} /></div>)}
    </div>
    <p id="empty-state" class="empty" hidden>No projects match that search.</p>
  </section>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const filter = document.querySelector<HTMLSelectElement>('#category-filter');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.project-item'));
  const empty = document.querySelector<HTMLElement>('#empty-state');

  function apply() {
    if (!search || !filter || !empty) return;
    const term = search.value.trim().toLowerCase();
    const category = filter.value;
    let visible = 0;

    for (const item of items) {
      const title = item.dataset.title ?? '';
      const student = item.dataset.student ?? '';
      const itemCategory = item.dataset.category ?? '';
      const match = (!term || title.includes(term) || student.includes(term))
        && (!category || itemCategory === category);
      item.hidden = !match;
      if (match) visible++;
    }

    empty.hidden = visible !== 0;
  }

  search?.addEventListener('input', apply);
  filter?.addEventListener('change', apply);
</script>
