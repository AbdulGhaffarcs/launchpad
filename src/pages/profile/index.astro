---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getSession } from '../../lib/session';
import { getUser, getRepoContent } from '../../lib/github';

export const prerender = false;
const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/api/auth/github?next=/profile');
const github = await getUser(session.accessToken);
const file = await getRepoContent(`src/content/profiles/${session.login.toLowerCase()}.json`);
let profile: Record<string,string> = {};
if (file?.content) { try { profile = JSON.parse(Buffer.from(file.content,'base64').toString('utf8')); } catch {} }
const projects = (await getCollection('projects')).filter(p => (p.data.ownerLogin ?? p.data.studentName).toLowerCase() === session.login.toLowerCase());
---
<BaseLayout title="Profile">
  <section class="profile-page">
    <p class="eyebrow">YOUR LAUNCHPAD</p>
    <h1>Profile & projects.</h1>
    <div class="profile-head">
      <img src={github.avatar_url} alt="" />
      <div><h2>{profile.displayName || github.name || github.login}</h2><p>@{github.login}</p>{github.html_url && <p><a class="text-link" href={github.html_url} target="_blank" rel="noopener noreferrer">Open GitHub profile ↗</a></p>}</div>
    </div>
    <div class="profile-grid">
      <section class="panel">
        <h2>Profile settings</h2>
        <form id="profile-form">
          <label>Display name<input name="displayName" value={profile.displayName || github.name || github.login} maxlength="80" /></label>
          <label style="margin-top:16px">Bio<textarea name="bio" rows="5" maxlength="280">{profile.bio || github.bio || ''}</textarea></label>
          <label style="margin-top:16px">Website<input name="website" type="url" value={profile.website || github.blog || ''} placeholder="https://..." /></label>
          <label style="margin-top:16px">LinkedIn<input name="linkedin" type="url" value={profile.linkedin || ''} placeholder="https://linkedin.com/in/..." /></label>
          <div class="form-actions"><button id="profile-save" class="button primary" type="submit">Save profile</button></div>
          <p id="profile-status" class="form-status"></p>
        </form>
      </section>
      <section class="panel">
        <h2>Your projects</h2>
        {projects.length === 0 ? <p class="muted">No projects are linked to this account yet.</p> : projects.map(project => <div class="project-row"><div><strong>{project.data.title}</strong><span>{project.data.category}</span></div><a class="button secondary" href={`/projects/${project.id}/edit`}>Edit</a></div>)}
      </section>
    </div>
  </section>
</BaseLayout>
<script>
  const form=document.querySelector<HTMLFormElement>('#profile-form');
  const button=document.querySelector<HTMLButtonElement>('#profile-save');
  const status=document.querySelector<HTMLElement>('#profile-status');
  form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!form||!button||!status)return;button.disabled=true;status.textContent='Saving…';const r=await fetch('/api/profile',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form).entries()))});const d=await r.json().catch(()=>({}));status.textContent=r.ok?'Saved. The live site is rebuilding now.':(d.error??'Could not save.');button.disabled=false;});
</script>
