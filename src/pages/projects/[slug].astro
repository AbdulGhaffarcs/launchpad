---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
const projects = await getCollection('projects');
const project = projects.find((p) => p.id === slug);
if (!project) return Astro.redirect('/');
const d = project.data;
---
<BaseLayout title={d.title} description={d.description}>
  <section class="project-detail">
    <a class="back" href="/">← Back to projects</a>
    <div class="detail-head">
      <div>
        <p class="eyebrow">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="detail-byline">Built by <strong>{d.studentName}</strong></p>
      </div>
      {d.featured && <span class="featured-badge big">Featured</span>}
    </div>

    <div class="detail-layout">
      <div>
        <section class="detail-section">
          <h2>What it does</h2>
          <p>{d.description}</p>
        </section>
        <section class="detail-section">
          <h2>Tech stack</h2>
          <div class="stack large">{d.stack.map((item) => <span>{item}</span>)}</div>
        </section>
      </div>
      <aside class="detail-actions">
        {d.github && <a class="button secondary full" href={d.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
        {d.demo && <a class="button primary full" href={d.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
        {d.github && <div class="star-box" data-slug={project.id} data-github={d.github}>
          <div class="star-count"><span id="star-number">—</span> GitHub stars</div>
          <button id="star-button" class="button star full" type="button">☆ Star repository</button>
          <p id="star-hint" class="muted small"></p>
        </div>}
        {d.linkedin && <a class="text-link" href={d.linkedin} target="_blank" rel="noopener noreferrer">Builder on LinkedIn ↗</a>}
        {d.lookingFor.length > 0 && <div class="looking"><h3>Looking for</h3><div class="stack">{d.lookingFor.map((x) => <span>{x}</span>)}</div></div>}
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  const box = document.querySelector<HTMLElement>('.star-box');

  if (box) {
    const button = document.querySelector<HTMLButtonElement>('#star-button');
    const count = document.querySelector<HTMLElement>('#star-number');
    const hint = document.querySelector<HTMLElement>('#star-hint');
    const slug = box.dataset.slug;

    async function load() {
      if (!button || !count || !hint || !slug) return;

      const response = await fetch(`/api/star?slug=${encodeURIComponent(slug)}`);
      if (!response.ok) return;

      const data = await response.json();
      count.textContent = String(data.count ?? '—');
      button.textContent = data.authenticated
        ? (data.starred ? '★ Starred on GitHub' : '☆ Star repository')
        : '☆ Star repository';
      hint.textContent = data.authenticated
        ? 'Uses your GitHub account. You stay signed in on this device.'
        : 'Sign in with GitHub to star it from Launchpad.';
    }

    button?.addEventListener('click', async () => {
      if (!button || !count || !hint || !slug) return;

      button.disabled = true;
      const response = await fetch('/api/star', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });

      if (response.status === 401) {
        window.location.href = `/api/auth/github?next=${encodeURIComponent(window.location.pathname)}`;
        return;
      }

      const data = await response.json();
      if (response.ok) {
        count.textContent = String(data.count ?? '—');
        button.textContent = data.starred ? '★ Starred on GitHub' : '☆ Star repository';
      } else {
        hint.textContent = data.error || 'GitHub did not allow the star action.';
      }
      button.disabled = false;
    });

    void load();
  }
</script>
