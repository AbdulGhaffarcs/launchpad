---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getRepo } from '../../lib/github';
import { parseGithubUrl } from '../../lib/utils';

export const prerender = false;
const { slug } = Astro.params;
const project = (await getCollection('projects')).find((item) => item.id === slug);
if (!project) return Astro.redirect('/projects');
const d = project.data;
let stars: number | null = null;
let githubUrl = d.github ?? null;
if (githubUrl) {
  try {
    const { owner, repo } = parseGithubUrl(githubUrl);
    const repository = await getRepo(null, owner, repo);
    stars = repository.stargazers_count;
    githubUrl = repository.html_url;
  } catch {}
}
const session = Astro.locals.session;
const editable = !!session && (d.ownerLogin?.toLowerCase() === session.login.toLowerCase() || d.studentName.toLowerCase() === session.login.toLowerCase());
---
<BaseLayout title={d.title} description={d.description}>
  <section class="detail-page">
    <a class="back" href="/projects">← All projects</a>
    <div class="detail-head">
      <div>
        <p class="eyebrow">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="detail-byline">Built by <strong>{d.studentName}</strong></p>
      </div>
      {d.featured && <span class="badge accent">Featured</span>}
    </div>

    <div class="detail-layout">
      <div>
        <section class="detail-section">
          <p class="eyebrow">ABOUT</p>
          <h2>What it does</h2>
          <p class="detail-copy">{d.description}</p>
        </section>
        <section class="detail-section">
          <p class="eyebrow">BUILT WITH</p>
          <h2>Tech stack</h2>
          <div class="stack large">{d.stack.map((item) => <span>{item}</span>)}</div>
        </section>
        {d.lookingFor.length > 0 && <section class="detail-section"><p class="eyebrow">NEXT</p><h2>Looking for</h2><div class="stack large">{d.lookingFor.map((item) => <span>{item}</span>)}</div></section>}
      </div>

      <aside class="detail-actions">
        {githubUrl && <a class="button secondary full" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
        {d.demo && <a class="button primary full" href={d.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
        {githubUrl && (
          <div class="star-box" data-slug={project.id}>
            <div class="star-count"><strong id="star-count">{stars ?? '—'}</strong> GitHub stars</div>
            <button id="star-button" class="button accent full" type="button">☆ Star on GitHub</button>
            <p id="star-hint" class="muted small">Sign in with GitHub to star it directly from Launchpad.</p>
          </div>
        )}
        {editable && <a class="button secondary full" href={`/projects/${project.id}/edit`}>Edit project</a>}
        {d.linkedin && <a class="text-link" href={d.linkedin} target="_blank" rel="noopener noreferrer">Builder on LinkedIn ↗</a>}
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  const box = document.querySelector<HTMLElement>('.star-box');
  const button = document.querySelector<HTMLButtonElement>('#star-button');
  const count = document.querySelector<HTMLElement>('#star-count');
  const hint = document.querySelector<HTMLElement>('#star-hint');
  const slug = box?.dataset.slug;

  async function refreshStarState() {
    if (!button || !count || !hint || !slug) return;
    try {
      const response = await fetch(`/api/star?slug=${encodeURIComponent(slug)}`);
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        hint.textContent = data.error ?? 'GitHub stars are unavailable right now.';
        return;
      }
      count.textContent = String(data.count ?? '—');
      button.textContent = data.starred ? '★ Starred on GitHub' : '☆ Star on GitHub';
      hint.textContent = data.authenticated
        ? 'Uses your GitHub account. Your session stays on this device.'
        : 'Sign in with GitHub to star it directly from Launchpad.';
    } catch {
      hint.textContent = 'Could not load GitHub star status.';
    }
  }

  button?.addEventListener('click', async () => {
    if (!button || !hint || !slug) return;
    button.disabled = true;
    hint.textContent = 'Updating GitHub…';

    try {
      const response = await fetch('/api/star', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      const data = await response.json().catch(() => ({}));

      if (response.status === 401 || (response.status === 403 && data.reauthorize)) {
        window.location.href = `/api/auth/github?next=${encodeURIComponent(window.location.pathname)}&reauthorize=1`;
        return;
      }

      if (!response.ok) {
        hint.textContent = data.error ?? 'GitHub did not allow the action.';
        return;
      }

      count!.textContent = String(data.count ?? '—');
      button.textContent = data.starred ? '★ Starred on GitHub' : '☆ Star on GitHub';
      hint.textContent = data.starred ? 'Star added to the repository.' : 'Star removed from the repository.';
    } catch {
      hint.textContent = 'Network error. Try again.';
    } finally {
      button.disabled = false;
    }
  });

  void refreshStarState();
</script>
