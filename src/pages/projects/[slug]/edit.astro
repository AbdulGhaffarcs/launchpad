---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = false;
const { slug } = Astro.params;
const project = (await getCollection('projects')).find((item) => item.id === slug);
const session = Astro.locals.session;
if (!project || !session) return Astro.redirect(project ? `/api/auth/github?next=/projects/${slug}/edit` : '/projects');
const d = project.data;
const owner = d.ownerLogin?.toLowerCase() === session.login.toLowerCase() || d.studentName.toLowerCase() === session.login.toLowerCase();
if (!owner) return Astro.redirect(`/projects/${slug}`);
const categories = ['AI','Web','Mobile','Systems','Security','Data','Education','Developer Tools','Other'];
---
<BaseLayout title={`Edit ${d.title}`}>
  <section class="submit-page">
    <a class="back" href={`/projects/${slug}`}>← Back to project</a>
    <p class="eyebrow" style="margin-top:40px">PROJECT SETTINGS</p>
    <h1>Edit your project.</h1>
    <p class="submit-copy">Your changes update the Launchpad record. In production, GitHub commits the change and Vercel publishes it automatically. In local development, the file is written directly to your working tree.</p>

    <form id="edit-form" class="form-card" data-slug={slug}>
      <div class="form-grid">
        <div class="field span-2"><label for="title">Project name</label><input id="title" name="title" value={d.title} required maxlength="100" /></div>
        <div class="field"><label for="category">Category</label><select id="category" name="category">{categories.map((category) => <option selected={category === d.category}>{category}</option>)}</select></div>
        <div class="field"><label for="github">GitHub repository</label><input id="github" name="github" type="url" value={d.github ?? ''} placeholder="https://github.com/you/project" /></div>
        <div class="repo-tools span-2"><label class="check-row"><input id="privateRepo" name="privateRepo" type="checkbox" value="true" checked={d.privateRepo} /><span>This repository is private</span></label><p class="field-note">Private repository URLs are never written to the public Launchpad record.</p></div>
        <div class="field span-2"><label for="description">What does it do / why is it useful?</label><textarea id="description" name="description" required maxlength="1200" rows="7">{d.description}</textarea></div>
        <div class="field"><label for="demo">Demo / website</label><input id="demo" name="demo" type="url" value={d.demo ?? ''} /></div>
        <div class="field"><label for="linkedin">LinkedIn</label><input id="linkedin" name="linkedin" type="url" value={d.linkedin ?? ''} /></div>
        <div class="field span-2"><label for="stack">Tech stack</label><input id="stack" name="stack" value={d.stack.join(', ')} /></div>
        <div class="field span-2"><label for="lookingFor">Looking for</label><input id="lookingFor" name="lookingFor" value={d.lookingFor.join(', ')} /></div>
      </div>
      <div class="form-actions"><button id="save" class="button primary" type="submit">Save changes</button><a class="button ghost" href={`/projects/${slug}`}>Cancel</a><button id="delete" class="button danger" type="button">Delete project</button></div>
      <div id="status" class="notice" aria-live="polite"></div>
    </form>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#edit-form');
  if (form) {
    const slug = form.dataset.slug;
    const save = document.querySelector<HTMLButtonElement>('#save');
    const del = document.querySelector<HTMLButtonElement>('#delete');
    const status = document.querySelector<HTMLElement>('#status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!slug || !save || !status) return;
      save.disabled = true; status.className = 'notice loading'; status.textContent = 'Saving…';
      try {
        const response = await fetch(`/api/projects/${encodeURIComponent(slug)}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(Object.fromEntries(new FormData(form).entries())) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) { status.className='notice error'; status.textContent=data.error ?? 'Could not save.'; return; }
        status.className='notice success'; status.textContent=data.local ? 'Saved locally. Returning…' : 'Saved. Returning…';
        window.setTimeout(() => { window.location.href = `/projects/${slug}`; }, 400);
      } catch { status.className='notice error'; status.textContent='Network error. Please try again.'; }
      finally { save.disabled = false; }
    });
    del?.addEventListener('click', async () => {
      if (!slug || !del || !status) return;
      if (!confirm('Delete this Launchpad project? The creator repository will not be changed.')) return;
      del.disabled = true; status.className='notice loading'; status.textContent='Deleting…';
      const response = await fetch(`/api/projects/${encodeURIComponent(slug)}`, { method:'DELETE' });
      const data = await response.json().catch(()=>({}));
      if (response.ok) { window.location.href='/projects'; return; }
      status.className='notice error'; status.textContent=data.error ?? 'Could not delete.'; del.disabled=false;
    });
  }
</script>
