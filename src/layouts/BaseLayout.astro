---
import '../styles.css';
const { title = 'Launchpad', description = 'Projects built by the IBA CS community.' } = Astro.props;
const session = Astro.locals.session;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0d" />
    <title>{title} · Launchpad</title>
    <link rel="icon" href="/launchpad-logo.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Launchpad home">
        <img class="brand-logo" src="/launchpad-logo.png" alt="" />
        <span>Launchpad</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/projects">Projects</a>
        <a href="/submit">Submit</a>
        {session ? (
          <>
            <a class="nav-user" href="/profile">
              <img class="nav-avatar" src={session.avatarUrl} alt="" />
              <span>Profile</span>
            </a>
            <form class="nav-form" method="post" action="/api/auth/logout">
              <button type="submit">Sign out</button>
            </form>
          </>
        ) : (
          <a href="/api/auth/github">Sign in with GitHub</a>
        )}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>Launchpad · projects built by IBA CS students</span>
      <a href="https://github.com/IBA-Launchpad/launchpad" target="_blank" rel="noopener noreferrer">Open source ↗</a>
    </footer>
  </body>
</html>
